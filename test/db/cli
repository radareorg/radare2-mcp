NAME=CLI DSL open calculate close
FILE=-
CMDS=<<EOF
!exec ../src/r2mcp -nN -T 'open_file file_path="hex://90c3"; calculate expression="0x100+4"; close_file'
EOF
EXPECT=
EXPECT_ERR=<<EOF
INFO: [R2MCP] r2mcp starting
INFO: [R2MCP] sandbox grain: socket
INFO: Radare2 core initialized
[DSL] open_file -> {"content":[{"type":"text","text":"File opened successfully."}]}
[DSL] calculate -> {"content":[{"type":"text","text":"0x104"}]}
[DSL] close_file -> {"content":[{"type":"text","text":"File closed successfully."}]}
EOF
RUN

