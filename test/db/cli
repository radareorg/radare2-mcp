NAME=CLI DSL search_gadgets handcrafted
FILE=-
CMDS=<<EOF
!exec ../src/r2mcp -nN -T 'open_file file_path="hex://5fc35ec39090909090909090909090909090909090909090909090909090909090909090" arch="x86" bits="64"; search_gadgets; search_gadgets query="pop rsi"; search_gadgets type="ret" page_size="1"; search_gadgets query="xor"; search_gadgets type="bogus"; close_file'
EOF
EXPECT=
EXPECT_ERR=<<EOF
INFO: [R2MCP] r2mcp starting
INFO: [R2MCP] sandbox grain: socket
INFO: Radare2 core initialized
[DSL] open_file -> {"content":[{"type":"text","text":"File opened successfully."}]}
[DSL] search_gadgets -> {"content":[{"type":"text","text":"0x00000000: pop rdi; ret;\n0x00000002: pop rsi; ret;"}]}
[DSL] search_gadgets -> {"content":[{"type":"text","text":"0x00000000: pop rdi; ret; pop rsi; ret;"}]}
[DSL] search_gadgets -> {"content":[{"type":"text","text":"0x00000000: pop rdi; ret;"}],"pagination":{"hasMore":true,"nextCursor":"1"}}
[DSL] search_gadgets -> {"content":[{"type":"text","text":"No gadgets found."}]}
[DSL] search_gadgets -> {"jsonrpc":"2.0","error":{"code":-32602,"message":"Invalid parameter 'type': expected any, ret, call, or jmp"}}
[DSL] close_file -> {"content":[{"type":"text","text":"File closed successfully."}]}
EOF
RUN

NAME=CLI stdio search_gadgets keeps the query literal
FILE=-
CMDS=<<EOF
!printf '%s\n' '{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"open_file","arguments":{"file_path":"hex://5fc35ec39090909090909090909090909090909090909090909090909090909090909090","arch":"x86","bits":"64"}}}' '{"jsonrpc":"2.0","id":2,"method":"tools/call","params":{"name":"search_gadgets","arguments":{"query":"ret;f injected=1"}}}' '{"jsonrpc":"2.0","id":3,"method":"tools/call","params":{"name":"calculate","arguments":{"expression":"injected"}}}' | ../src/r2mcp -nN -C json
EOF
EXPECT=<<EOF
{"jsonrpc":"2.0","id":1,"result":{"content":[{"type":"text","text":"File opened successfully."}]}}
{"jsonrpc":"2.0","id":2,"result":{"content":[{"type":"text","text":"{\"gadgets\":[]}"}]}}
{"jsonrpc":"2.0","id":3,"result":{"content":[{"type":"text","text":"0x0"}]}}
EOF
EXPECT_ERR=<<EOF
INFO: [R2MCP] r2mcp starting
INFO: [R2MCP] sandbox grain: socket
INFO: Radare2 core initialized
EOF
RUN
