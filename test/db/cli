NAME=CLI stdio ping notification and unknown method
FILE=-
CMDS=<<EOF
!printf '%s\n' '{"jsonrpc":"2.0","method":"notifications/initialized"}' '{"jsonrpc":"2.0","id":1,"method":"ping"}' '{"jsonrpc":"2.0","id":2,"method":"unknown"}' | ../src/r2mcp -nN
EOF
EXPECT=<<EOF
{"jsonrpc":"2.0","id":1,"result":{}}
{"jsonrpc":"2.0","id":2,"error":{"code":-32601,"message":"Unknown method"}}
EOF
EXPECT_ERR=<<EOF
INFO: [R2MCP] r2mcp starting
INFO: [R2MCP] sandbox grain: socket
INFO: Radare2 core initialized
EOF
RUN

