INFO: [R2MCP] r2mcp starting
INFO: [R2MCP] sandbox grain: socket
INFO: Radare2 core initialized
[DSL] open_file -> {"content":[{"type":"text","text":"File opened successfully."}]}
[DSL] show_function_graph -> {"content":[{"type":"text","text":"No function found at 0x0. Run analyze first or use an address from list_functions."}]}
[DSL] run_command -> {"content":[{"type":"text","text":""}]}
[DSL] run_command -> {"content":[{"type":"text","text":""}]}
[DSL] run_command -> {"content":[{"type":"text","text":""}]}
[DSL] run_command -> {"content":[{"type":"text","text":""}]}
[DSL] show_function_graph -> {"content":[{"type":"text","text":"entry 0x0: 3 blocks, 5 instructions, 7 bytes\n0x0 size=4 ninstr=2 jump=0x5 fail=0x4\n0x4 size=1 ninstr=1\n0x5 size=2 ninstr=2\n"}]}
[DSL] show_function_graph -> {"content":[{"type":"text","text":"entry 0x0: 3 blocks, 5 instructions, 7 bytes\n0x0 size=4 ninstr=2 jump=0x5 fail=0x4\n| 0x0 test edi, edi\n| 0x2 je 5"}],"pagination":{"hasMore":true,"nextCursor":"4"}}
