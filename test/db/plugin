NAME=Plugin default status
FILE=hex://90c3
CMDS=<<EOF
L ../src/libcore_r2mcp.`!r2 -H R2_LIBEXT`
e r2mcp.prompts=false
r2mcp status
EOF
EXPECT=<<EOF
http: stopped
log: false
approve: false
yolo: false
auth: disabled
content: text
readonly: false
permissive: false
run_command: false
EOF
EXPECT_ERR=
RUN

